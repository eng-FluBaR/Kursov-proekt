{
  "name": "kursov-proekt",
  "version": "1.0.0",
  "description": "3D Job Planer app: Next.js + React + Expo",
  "license": "ISC",
  "author": "Petar Tonev",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "packages/db",
    "3d-jobs-web",
    "3d-jobs-mobile",
    "3d-jobs-share"
  ],
  "scripts": {
    "bootstrap": "npm ci",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:web": "npm --workspace 3d-jobs-web run dev -- -p 3001",
    "dev:mobile": "npm --workspace 3d-jobs-mobile run start",
    "build:web": "npm --workspace 3d-jobs-web run build",
    "build:mobile": "npm --workspace 3d-jobs-mobile run build --if-present",
    "db:migrate": "npm --workspace @3d-jobs/db run migrate",
    "db:seed": "npm --workspace @3d-jobs/db run seed",
    "db:seed-demo-paging": "npm --workspace @3d-jobs/db run seed:demo-paging",
    "lint": "npm --workspace 3d-jobs-web run lint && npm --workspace 3d-jobs-mobile run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
